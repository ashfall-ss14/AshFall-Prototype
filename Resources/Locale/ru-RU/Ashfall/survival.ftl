# Отмычки
ashfall-lockpick = отмычка
ashfall-lockpick-desc = Набор тонких металлических щупов и воротка для вскрытия механических замков и затворов.
ashfall-lockpick-failed = Отмычка соскальзывает и заклинивает в механизме замка.
ashfall-lockpick-success = Механизм замка щёлкает и поддаётся взлому!
ashfall-lockpick-verb = Взломать замок

ent-AshfallLockpick = отмычка
    .desc = Набор тонких металлических щупов и воротка для вскрытия механических замков и затворов.

# Сложный ремонт
ashfall-complex-repairable-success = Вы успешно завершаете ремонт {THE($target)} сварочным аппаратом.
ashfall-complex-repairable-material-needed = Повреждения {THE($target)} слишком сильны! Сначала залатайте бреши: требуется { $left } шт. { $material }.
ashfall-complex-repairable-material-success = Вы вставляете заплату в {THE($target)}. Осталось установить { $left } шт.
ashfall-complex-repairable-examine = [color=orange]Требуется армирование: вставьте { $material } ({ $amount } шт.) перед сваркой.[/color]

# Баррикады
ashfall-barricade-wooden = деревянная баррикада
