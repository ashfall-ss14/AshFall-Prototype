# ==============================================================================
# Step 1: Origin (First-person dialogue)
# ==============================================================================

ashfall-lifepath-step1-mining-title = Outer Ring Pits
ashfall-lifepath-step1-mining-desc = "I was born in a mining settlement by the pits. Until I was eight, I thought skies only existed in paintings."

ashfall-lifepath-step1-orbital-title = Orbital Junction
ashfall-lifepath-step1-orbital-desc = "I grew up on a transit station. Thousands passed through every week. Nothing to write home about."

ashfall-lifepath-step1-agri-title = Frontier Agrodome
ashfall-lifepath-step1-agri-desc = "My parents worked in a domed greenhouse. It was always stifling and humid in there."

ashfall-lifepath-step1-freight-title = Freight Transit Hub
ashfall-lifepath-step1-freight-desc = "Our quarters were right next to the landing pad. Stevedores swapped shifts every eight hours."

ashfall-lifepath-step1-stationfamily-title = Residential Habitat
ashfall-lifepath-step1-stationfamily-desc = "Three generations of my family lived in the same habitat block, on one of the endless stations."

ashfall-lifepath-step1-corporate-title = Corporate Enclave
ashfall-lifepath-step1-corporate-desc = "Born in the heart of bureaucracy, with an employee badge around my neck."

ashfall-lifepath-step1-independent-title = Free Outpost
ashfall-lifepath-step1-independent-desc = "Out there was no law and no police. If you didn't work, you didn't eat."

ashfall-lifepath-step1-maintenance-title = Technical Crawlways
ashfall-lifepath-step1-maintenance-desc = "I lived among steel plates and cable trunks. We couldn't afford any other home."

ashfall-lifepath-step1-earthmetro-title = Earth Megacity Underlevels
ashfall-lifepath-step1-earthmetro-desc = "Born on the bottom decks down on Earth. I saw the real sun for the first time at fourteen."

ashfall-lifepath-step1-lunar-title = Lunar Biodome
ashfall-lifepath-step1-lunar-desc = "Born in one of the many lunar colonies."

ashfall-lifepath-step1-shipboard-title = Scheduled Shuttle Berths
ashfall-lifepath-step1-shipboard-desc = "My family lived on a transit shuttle. A two-by-two meter cabin, for three of us."

ashfall-lifepath-step1-frontierport-title = Frontier Free Port
ashfall-lifepath-step1-frontierport-desc = "A port on the rim of inhabited space. Nobody asked unnecessary questions there."

ashfall-lifepath-step1-arcology-title = Industrial Arcology
ashfall-lifepath-step1-arcology-desc = "The arcology was one giant factory that people also lived in. Sixteen-hour shifts."

ashfall-lifepath-step1-research-title = Research Enclave
ashfall-lifepath-step1-research-desc = "That place was obsessed with knowledge and progress. Often at the cost of comfort and stability."

ashfall-lifepath-step1-medhabitat-title = Medical Care Habitat
ashfall-lifepath-step1-medhabitat-desc = "Mother worked in the clinic. Half of my childhood was spent in the duty room."

ashfall-lifepath-step1-garrison-title = Security Garrison
ashfall-lifepath-step1-garrison-desc = "My father served in the garrison; muster alarms woke us even at home. I still make my bed without a crease."

ashfall-lifepath-step1-servicequarter-title = Service Concourse
ashfall-lifepath-step1-servicequarter-desc = "One parent washed laundry, the other worked the galley. We mostly saw our superiors from the back."

ashfall-lifepath-step1-penal-title = Penal Work Settlement
ashfall-lifepath-step1-penal-desc = "Parents did time in the penal colony, and we lived alongside it. Convicts were housed right among everyone else."

ashfall-lifepath-step1-salvagebarge-title = Salvage Barge
ashfall-lifepath-step1-salvagebarge-desc = "The barge tore decommissioned hulls apart for scrap. We lived in a former officer's quarters."

ashfall-lifepath-step1-underdeck-title = Underdeck Catacombs
ashfall-lifepath-step1-underdeck-desc = "Security only came down to the lowest decks in squad formation. We knew every crawlspace."

ashfall-lifepath-step1-kassik-title = Lowlands of Kassik
ashfall-lifepath-step1-kassik-desc = "In the ash wastelands of Kha-Ssar, the sun scorches scales in half an hour. Fall behind the caravan, and no one turns back for you."

ashfall-lifepath-step1-unathiforge-title = Unathi Forge Guild
ashfall-lifepath-step1-unathiforge-desc = "From age ten they trained me with a plasma cleaver. Before that, they simply wouldn't allow it."

ashfall-lifepath-step1-kirwani-title = Bio-chambers of Clan Kirwani
ashfall-lifepath-step1-kirwani-desc = "Our clan bred silkworms in heated bio-chambers. Every single batch was cataloged in the ledger."

ashfall-lifepath-step1-luamnomad-title = Luam Nomad Flotilla
ashfall-lifepath-step1-luamnomad-desc = "We lived aboard battered shuttles, trading fabric and seeds. Moving every few months, keeping few belongings."

ashfall-lifepath-step1-arachnidcavern-title = Arachnid Subterranean Shaft
ashfall-lifepath-step1-arachnidcavern-desc = "Our cavern vaults were braced with web supports. I feel cracks in the rock with my paws long before I hear them."

ashfall-lifepath-step1-arachnidweb-title = Station Web Cluster
ashfall-lifepath-step1-arachnidweb-desc = "Our clan spun a nest in the station's upper trusses. Very fine view of the cargo conveyors from up there."

ashfall-lifepath-step1-veiruhighland-title = Veiru Highland Pride
ashfall-lifepath-step1-veiruhighland-desc = "Our pride lived on the highlands where the wind stings your eyes. You listened to senior hunters there."

ashfall-lifepath-step1-veirudesert-title = Veiru Desert Outpost
ashfall-lifepath-step1-veirudesert-desc = "Our watchpost stood on the dune edge. We waited for days just for movement on the horizon."

# ==============================================================================
# Step 2: Craft & Specialization (First-person dialogue)
# ==============================================================================

ashfall-lifepath-step2-engi-title = Wrench and Welding
ashfall-lifepath-step2-engi-desc = "My hands grew used to a heavy wrench and arc welding. Got my first burn on day three, from a bare rod without gloves."

ashfall-lifepath-step2-atmos-title = Pipes and Ventilation
ashfall-lifepath-step2-atmos-desc = "Palm against a manifold, I feel pressure bleed before a gauge registers. Gauges lied more often than hands."

ashfall-lifepath-step2-salvage-title = Cutting and Salvage
ashfall-lifepath-step2-salvage-desc = "My hands grew used to stiff EVA gloves and the plasma cutter. Drop a tool in vacuum, and it's gone forever."

ashfall-lifepath-step2-med-title = Medical Care
ashfall-lifepath-step2-med-desc = "My hands stitched lacerations and tied tourniquets. They stopped shaking after the first shift."

ashfall-lifepath-step2-paramedic-title = Field Rescue
ashfall-lifepath-step2-paramedic-desc = "My hands got used to stretchers and clamps. If a hatch jams, I force it with a crowbar."

ashfall-lifepath-step2-chemist-title = Chemical Synthesis
ashfall-lifepath-step2-chemist-desc = "My hands worked flasks and precision balances. Won't mix up reagents even if the label wore off."

ashfall-lifepath-step2-sec-title = Station Security
ashfall-lifepath-step2-sec-desc = "My hands got used to stun batons, riot shields, and cuffing a suspect without snapping their wrists."

ashfall-lifepath-step2-warden-title = Custody and Protocols
ashfall-lifepath-step2-warden-desc = "My hands grew used to key rings and the armory log. Cell locked, gear accounted for, signature signed."

ashfall-lifepath-step2-detective-title = Evidence Search
ashfall-lifepath-step2-detective-desc = "Dusting prints with a brush, picking up spent casings with tweezers. Changing gloves every time."

ashfall-lifepath-step2-serv-title = Station Maintenance
ashfall-lifepath-step2-serv-desc = "My hands grew used to mops and spare air filters. Small stuff usually breaks first, and whoever is nearest fixes it."

ashfall-lifepath-step2-cook-title = Provisions and Galley
ashfall-lifepath-step2-cook-desc = "My hands cooked for the whole rotation, a hundred portions. They still remember the weight of the soup cauldron."

ashfall-lifepath-step2-botanist-title = Greenhouse and Hydroponics
ashfall-lifepath-step2-botanist-desc = "My hands got used to damp substrate and delicate replanting. Crops don't wait, so it often meant graveyard hours."

ashfall-lifepath-step2-cargo-title = Freight and Warehousing
ashfall-lifepath-step2-cargo-desc = "My hands know how to stack crates so the pile doesn't topple. I pull the bottom crate without unpacking the top."

# ==============================================================================
# Step 3: Character & Stress Reaction (First-person dialogue)
# ==============================================================================

ashfall-lifepath-step3-pedant-title = Thoroughness
ashfall-lifepath-step3-pedant-desc = "When everything collapses, I open the handbook and work step by step. Less chance of missing something vital."
ashfall-lifepath-step3-pedant-weakness = Clings to protocols even when they don't fit the crisis.

ashfall-lifepath-step3-daredevil-title = Decisiveness
ashfall-lifepath-step3-daredevil-desc = "Better to act right away, even if flawed. I can't stand waiting around for others to make up their minds."
ashfall-lifepath-step3-daredevil-weakness = Takes reckless risks in pursuit of rapid resolutions.

ashfall-lifepath-step3-paranoid-title = Prudence
ashfall-lifepath-step3-paranoid-desc = "I double-check airlock dog-latches, and I don't trust crew reports until I see the pressure myself."
ashfall-lifepath-step3-paranoid-weakness = Mistrustful of crewmates and spends excessive time re-verifying safety.

ashfall-lifepath-step3-burnout-title = Composure
ashfall-lifepath-step3-burnout-desc = "I've seen enough hull breaches. Panic doesn't patch metal, so I just quietly do what must be done."
ashfall-lifepath-step3-burnout-weakness = Emotionally detached and dismissive of others' panic.

ashfall-lifepath-step3-stoic-title = Steadfastness
ashfall-lifepath-step3-stoic-desc = "Under emergency lighting, I don't chatter. Words won't weld a ruptured line."
ashfall-lifepath-step3-stoic-weakness = Reluctant to communicate personal strain and conceals exhaustion.

ashfall-lifepath-step3-pragmatist-title = Pragmatism
ashfall-lifepath-step3-pragmatist-desc = "I count oxygen, bandages, and heads we can still haul out. Sometimes a choice has to be made, and I make it."
ashfall-lifepath-step3-pragmatist-weakness = Willing to sacrifice others' comfort for overall operational survival.

ashfall-lifepath-step3-idealist-title = Integrity
ashfall-lifepath-step3-idealist-desc = "I don't leave my people behind and I keep my word, even if directives say otherwise."
ashfall-lifepath-step3-idealist-weakness = Refuses pragmatic compromises in favor of rigid principles.

ashfall-lifepath-step3-diplomat-title = Diplomacy
ashfall-lifepath-step3-diplomat-desc = "I know how to talk down terrified people before they pull the trigger. A couple of calm minutes usually does it."
ashfall-lifepath-step3-diplomat-weakness = Tries to negotiate when decisive force is immediately required.

# ==============================================================================
# Step 4: Motivation (First-person dialogue)
# ==============================================================================

ashfall-lifepath-step4-balance-title = Fair Contract
ashfall-lifepath-step4-balance-desc = "ASH-07 paid more than neighboring sites. I had debts, and this contract pays them off in two years."
ashfall-lifepath-step4-balance-quirk = Closely monitors duty rosters and payroll logs.

ashfall-lifepath-step4-decay-title = Fresh Start
ashfall-lifepath-step4-decay-desc = "This contract was my ticket away from the past. ASH-07 was far enough away."
ashfall-lifepath-step4-decay-quirk = Deflects inquiries regarding past assignments.

ashfall-lifepath-step4-indifference-title = Professional Challenge
ashfall-lifepath-step4-indifference-desc = "ASH-07 had worn-out equipment and a skeleton crew, or so they told me. Battered outposts were always more interesting than polished ones."
ashfall-lifepath-step4-indifference-quirk = Eagerly takes on severe structural failures and hazardous repairs.

ashfall-lifepath-step4-stubborn-title = Duty & Loyalty
ashfall-lifepath-step4-stubborn-desc = "Transferred to ASH-07 by assignment. Until someone relieves me at my post, I'm staying put."
ashfall-lifepath-step4-stubborn-quirk = Refuses to leave assigned responsibilities incomplete under any conditions.

ashfall-lifepath-step4-predator-title = Career Growth
ashfall-lifepath-step4-predator-desc = "Promotions happen faster on remote berths, fewer people want them. Plan was to return with rank."
ashfall-lifepath-step4-predator-quirk = Actively seeks opportunities to optimize workflow and impress leadership.

ashfall-lifepath-step4-idealist-title = Crew Support
ashfall-lifepath-step4-idealist-desc = "ASH-07 was short-handed. Someone had to go, and it happened to be me."
ashfall-lifepath-step4-idealist-quirk = Always willing to share rations or take on extra workload for weary peers.

ashfall-lifepath-step4-ghost-title = Quiet Focus
ashfall-lifepath-step4-ghost-desc = "Wanted a posting without command hovering over my shoulder. ASH-07 fit the bill: quiet and distant."
ashfall-lifepath-step4-ghost-quirk = Avoids bustling corridors and prefers quiet night rotations.

ashfall-lifepath-step4-fatalist-title = Dedicated Calling
ashfall-lifepath-step4-fatalist-desc = "I just enjoy doing good work. ASH-07 had plenty that needed fixing, and that was enough for me."
ashfall-lifepath-step4-fatalist-quirk = Takes intense personal pride in the craftsmanship of every repair.

