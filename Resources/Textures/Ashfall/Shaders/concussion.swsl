// Ashfall Concussion Head Trauma Post-Processing Shader
// Activates dynamically when suffering head concussion / blast trauma.

uniform sampler2D SCREEN_TEXTURE;
uniform highp float ConcussionIntensity; // 0.0 to 1.0

void fragment() {
    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp vec2 centerOffset = coord - vec2(0.5);
    highp float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
    centerOffset.x *= aspect;
    highp float dist = length(centerOffset);

    // Dizziness wobble
    highp float wobble = sin(TIME * 2.0) * 0.006 * ConcussionIntensity;
    highp vec2 wobbledCoord = coord + vec2(wobble * centerOffset.y, wobble * centerOffset.x);

    // Double vision / blur separation (minimal taps)
    highp float blurDist = 0.008 * ConcussionIntensity;
    highp vec3 col1 = zTextureSpec(SCREEN_TEXTURE, wobbledCoord + vec2(blurDist, 0.0)).rgb;
    highp vec3 col2 = zTextureSpec(SCREEN_TEXTURE, wobbledCoord - vec2(blurDist, 0.0)).rgb;
    highp vec4 colBase = zTextureSpec(SCREEN_TEXTURE, wobbledCoord);
    highp vec3 col = (colBase.rgb * 0.5) + (col1 + col2) * 0.25;

    // Dark tunnel vignette
    highp float vigRadius = 0.85 - (ConcussionIntensity * 0.50);
    highp float vigSoftness = 0.35 + (ConcussionIntensity * 0.10);
    highp float vigFactor = 1.0 - smoothstep(vigRadius - vigSoftness, vigRadius, dist);
    highp float vignette = mix(1.0, clamp(vigFactor, 0.10, 1.0), ConcussionIntensity);

    col *= vignette;

    COLOR = vec4(col, colBase.a);
}
