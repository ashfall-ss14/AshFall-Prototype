// Retro pixelated deep space backdrop for Ashfall Lifepath.
// Low-res chunky pixel grid, drifting cold grey-ash blobs, faint star dust.

highp float hash21(highp vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

void fragment() {
    // 1. Chunky retro pixelation grid
    highp float pixelBlock = 4.0;
    highp vec2 pixelGrid = floor(FRAGCOORD.xy / pixelBlock);
    highp vec2 fragCoord = pixelGrid * pixelBlock;
    highp vec2 uv = fragCoord * SCREEN_PIXEL_SIZE.xy;

    highp float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
    highp vec2 p = (uv - vec2(0.5)) * vec2(1.0, 1.0 / aspect) * 2.0;

    highp float t = TIME * 0.18;

    // 2. Slow organic domain warp
    highp vec2 q = vec2(
        sin(p.y * 1.1 + t * 0.3) + cos(p.x * 0.8 - t * 0.2),
        cos(p.x * 1.0 - t * 0.25) + sin(p.y * 1.2 + t * 0.35)
    );

    highp vec2 r = vec2(
        sin(p.x * 1.3 + q.x * 0.7 + t * 0.15),
        cos(p.y * 1.2 + q.y * 0.7 - t * 0.2)
    );

    highp float dist = length(p - r * 0.4);
    highp float blob = sin(dist * 2.6 - t * 0.4) * 0.5 + 0.5;
    blob *= (1.0 - smoothstep(0.2, 2.0, dist));

    highp vec2 p2 = p + vec2(sin(t * 0.25) * 0.5, cos(t * 0.2) * 0.4);
    highp float dist2 = length(p2);
    highp float blob2 = (1.0 - smoothstep(0.0, 1.4, dist2)) * (sin(p2.x * 1.8 - t * 0.3) * 0.5 + 0.5);

    highp float totalBlob = clamp(blob * 0.65 + blob2 * 0.35, 0.0, 1.0);

    // 3. Deep space black with subtle grey-ash masses
    highp vec3 colVoid = vec3(0.015, 0.017, 0.020);
    highp vec3 colGrey = vec3(0.065, 0.072, 0.082);
    highp vec3 colAsh  = vec3(0.095, 0.100, 0.110);

    highp vec3 color = mix(colVoid, colGrey, smoothstep(0.2, 0.8, totalBlob));
    color = mix(color, colAsh, smoothstep(0.5, 0.95, totalBlob) * 0.6);

    // 4. Subtle pixel star dust in the cold void
    highp float rnd = hash21(pixelGrid);
    if (rnd > 0.9972) {
        highp float twinkle = sin(t * 2.0 + rnd * 6.28) * 0.3 + 0.7;
        color += vec3(0.18, 0.20, 0.24) * twinkle;
    }

    // 5. Retro 5-bit color step (32 levels) for pixel art banding
    color = floor(color * 36.0) / 36.0;

    COLOR = vec4(color, 1.0);
}
