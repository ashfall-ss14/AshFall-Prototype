light_mode unshaded;

uniform highp float progress;
uniform highp float time;
uniform highp float isSilhouette;

highp float hash21(highp vec2 p) {
    p = fract(p * vec2(234.34, 435.345));
    p += dot(p, p + 34.23);
    return fract(p.x * p.y);
}

void fragment() {
    highp vec4 col = texture2D(TEXTURE, UV);
    if (col.a < 0.01) {
        COLOR = vec4(0.0);
        return;
    }

    // Step 1: Dark mysterious silhouette
    if (isSilhouette > 0.5) {
        // Deep charcoal tone with subtle atmospheric scanline shimmer
        highp float shimmer = sin(UV.y * 60.0 + time * 1.8) * 0.03;
        highp vec3 sil = vec3(0.05, 0.065, 0.09) + vec3(shimmer);
        COLOR = vec4(sil, col.a * 0.95);
        return;
    }

    // Morph transition between steps (pixel dissolve / glitch sweep)
    if (progress < 1.0) {
        // Pixel grid size (approx 64x128 blocks)
        highp vec2 blockUV = floor(UV * vec2(48.0, 96.0));
        highp float noise = hash21(blockUV);

        // Vertical progression gradient combined with pixel noise
        highp float threshold = progress * 1.3 - (1.0 - UV.y) * 0.3;

        if (noise > threshold + 0.08) {
            // Unrevealed / silhouette portion
            highp float shimmer = sin(UV.y * 60.0 + time * 2.0) * 0.04;
            highp vec3 sil = vec3(0.05, 0.065, 0.09) + vec3(shimmer);
            COLOR = vec4(sil, col.a * 0.85);
        } else if (noise > threshold) {
            // Bright amber / plasma glitch edge during dissolve
            COLOR = vec4(0.95, 0.65, 0.25, col.a);
        } else {
            // Revealed texture with subtle horizontal scan glitch
            highp float glitch = sin(UV.y * 120.0 + time * 8.0) * (1.0 - progress) * 0.02;
            highp vec4 tex = texture2D(TEXTURE, UV + vec2(glitch, 0.0));
            COLOR = tex;
        }
    } else {
        COLOR = col;
    }
}
