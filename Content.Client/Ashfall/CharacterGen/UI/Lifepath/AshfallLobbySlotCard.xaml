<PanelContainer xmlns="https://spacestation14.io"
                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:ashfall="clr-namespace:Content.Client.Ashfall.CharacterGen.UI"
                MinWidth="280" MaxWidth="320" MinHeight="480"
                HorizontalExpand="True" VerticalExpand="True">
    <PanelContainer Name="CardPanel" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#151618" BorderColor="#2C2E33" BorderThickness="1" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8" HorizontalExpand="True" VerticalExpand="True">
            <!-- Header: Slot Number & Status Badge -->
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Name="SlotNumberLabel" StyleClasses="FancyWindowTitle" Text="СЛОТ #1" FontColorOverride="#A3A8A3" />
                <Control HorizontalExpand="True" />
                <PanelContainer Name="StatusBadgePanel" Margin="4 0">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#242629" BorderColor="#3D4045" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <Label Name="StatusBadgeLabel" Margin="6 2" StyleClasses="AshfallStatus" Text="ВАКАНТНО" />
                </PanelContainer>
            </BoxContainer>

            <!-- Center Content: Empty Silhouette OR Character FullBody Sprite -->
            <PanelContainer Name="PreviewContainer" MinHeight="260" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#0E0F10" BorderColor="#1E2024" BorderThickness="1" />
                </PanelContainer.PanelOverride>

                <!-- Occupied View -->
                <ashfall:ProfileFullBodySpriteView Name="PreviewSprite" HorizontalExpand="True" VerticalExpand="True" />

                <!-- Empty View -->
                <BoxContainer Name="EmptyContainer" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" SeparationOverride="8">
                    <TextureRect Name="EmptyIcon" TexturePath="/Textures/Interface/Nano/inverted_cross.svg.96dpi.png"
                                 SetSize="48 48" HorizontalAlignment="Center" ModulateSelfOverride="#454950" />
                    <Label Name="EmptyTitleLabel" Text="{Loc 'ashfall-lobby-slot-empty'}" StyleClasses="AshfallTerminalHeader"
                           HorizontalAlignment="Center" FontColorOverride="#5C626C" />
                    <Label Name="EmptyHintLabel" Text="{Loc 'ashfall-lobby-slot-create'}" StyleClasses="AshfallStatus"
                           HorizontalAlignment="Center" FontColorOverride="#7A828F" />
                </BoxContainer>

                <!-- Full Area Click Button for Empty Slot -->
                <Button Name="EmptySlotButton" StyleClasses="ButtonOpenBoth" HorizontalExpand="True" VerticalExpand="True" Visible="False" />
            </PanelContainer>

            <!-- Character Info (Occupied) -->
            <BoxContainer Name="InfoContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                <Label Name="NameLabel" StyleClasses="FancyWindowTitle" ClipText="True" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <PanelContainer Name="JobColorBar" SetSize="4 16" VerticalAlignment="Center">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#D48944" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <Label Name="JobLabel" FontColorOverride="#D48944" StyleClasses="AshfallStatus" ClipText="True" HorizontalExpand="True" />
                </BoxContainer>
                <Label Name="BioLabel" FontColorOverride="#878C87" ClipText="True" />
                <Label Name="FlawLabel" FontColorOverride="#A87A65" ClipText="True" />
            </BoxContainer>

            <!-- Action Buttons Footer -->
            <BoxContainer Name="ActionsContainer" Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True" Margin="0 4 0 0">
                <Button Name="SelectButton" Text="{Loc 'ashfall-lobby-slot-button-select'}"
                        StyleClasses="AshfallNavigationAction" HorizontalExpand="True" MinHeight="32" />
                <Button Name="ResetButton" Text="{Loc 'ashfall-lobby-slot-button-reset'}"
                        StyleClasses="AshfallDestructiveAction" MinHeight="32" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</PanelContainer>
