<PanelContainer xmlns="https://spacestation14.io"
                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:layout="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
                xmlns:ashfall="clr-namespace:Content.Client.Ashfall.CharacterGen.UI"
                HorizontalExpand="True" VerticalExpand="True">
    <PanelContainer.PanelOverride>
        <graphics:StyleBoxFlat BackgroundColor="#07080A" />
    </PanelContainer.PanelOverride>

    <ashfall:AshfallDossierBackground />

    <BoxContainer Orientation="Vertical" Margin="36 20" SeparationOverride="12" HorizontalExpand="True" VerticalExpand="True">
        <!-- Top Strip: Back button on the left, progress rail on the right -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="36">
            <Button Name="BackButton" Text="{Loc 'ashfall-lifepath-back-button'}" StyleClasses="AshfallInlineAction" VerticalAlignment="Center" />
            <Control HorizontalExpand="True" />
            <BoxContainer Name="ProgressRail" Orientation="Horizontal" SeparationOverride="6" VerticalAlignment="Center" />
            <Control MinWidth="14" />
            <Label Name="StepCounterLabel" StyleClasses="AshfallDossierLabel" VAlign="Center" />
        </BoxContainer>

        <!-- Centered 2-Column Stage -->
        <Control VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                      SeparationOverride="36" HorizontalExpand="True">
            <!-- Left Column: Character Card (Portrait + Identity + Chronicle) -->
            <BoxContainer Orientation="Vertical" MinWidth="340" MaxWidth="360" SeparationOverride="12">
                <PanelContainer Name="CharacterCard" HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#0F1114EE" BorderColor="#22262E" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10" HorizontalExpand="True">
                        <!-- Portrait Area with CRT Noise Overlay -->
                        <PanelContainer Name="SpriteFrame" MinSize="180 220" SetSize="180 220" HorizontalAlignment="Center">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#07080A" BorderColor="#1A1D24" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                            <layout:LayoutContainer RectClipContent="True">
                                <ashfall:ProfilePortraitSpriteView Name="PreviewSprite" MinSize="180 220" SetSize="180 220" PortraitFraction="0.55" VerticalOffset="12" />
                                <TextureRect Name="PortraitNoise" Stretch="Tile" MouseFilter="Ignore" MinSize="180 220" SetSize="180 220" />
                            </layout:LayoutContainer>
                        </PanelContainer>

                        <!-- Identity Plate (Name, Sex, Culture, Reroll) -->
                        <BoxContainer Name="IdentityBlock" Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
                                <Label Name="CharacterNameLabel" StyleClasses="AshfallCandidateName" HorizontalExpand="True" VAlign="Center" ClipText="True" />
                                <Button Name="RerollNameButton" Text="{Loc 'ashfall-lifepath-reroll-name'}" StyleClasses="AshfallUtilityAction" MinHeight="26" Visible="False" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                                <Button Name="MaleSexButton" Text="{Loc 'ashfall-lifepath-sex-male'}" StyleClasses="AshfallUtilityAction" MinHeight="24" MinWidth="32" Visible="False" />
                                <Button Name="FemaleSexButton" Text="{Loc 'ashfall-lifepath-sex-female'}" StyleClasses="AshfallUtilityAction" MinHeight="24" MinWidth="32" Visible="False" />
                                <Control MinWidth="4" />
                                <Label Name="CharacterBioLabel" StyleClasses="AshfallDossierLabel" VAlign="Center" HorizontalExpand="True" ClipText="True" />
                                <Label Name="CharacterJobTag" StyleClasses="AshfallDossierLabel" VAlign="Center" />
                            </BoxContainer>
                        </BoxContainer>

                        <!-- Divider -->
                        <PanelContainer SetSize="0 1" HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#1E2228" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>

                        <!-- Chronicle / Ledger (Records chosen steps dynamically) -->
                        <BoxContainer Name="ChronicleContainer" Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- Right Column: Narrative dialogue choices / Final dossier -->
            <BoxContainer Orientation="Vertical" MinWidth="580" MaxWidth="680" SeparationOverride="14" VerticalAlignment="Center">
                <BoxContainer Name="ContentColumn" Orientation="Vertical" SeparationOverride="18" HorizontalExpand="True">
                    <Label Name="PromptQuestionLabel" StyleClasses="AshfallDossierDisplay" />

                    <!-- Steps 1-4: Narrative Choices -->
                    <BoxContainer Name="OptionsContainer" Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" Margin="0 4 0 0" />

                    <!-- Step 5: Final Dossier Decisions -->
                    <BoxContainer Name="DossierContainer" Orientation="Vertical" SeparationOverride="16" HorizontalExpand="True" Visible="False">
                        <!-- Introspective evaluation card -->
                        <BoxContainer Name="DossierSections" Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True" />

                        <!-- Job & Experience assignment -->
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#0F1114CC" BorderColor="#22262E" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="14 12" SeparationOverride="10" HorizontalExpand="True">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                                    <Label Text="{Loc 'ashfall-lifepath-field-experience'}" StyleClasses="AshfallDossierLabel" VAlign="Center" MinWidth="110" />
                                    <OptionButton Name="ExperienceOption" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                                    <Label Text="{Loc 'ashfall-lifepath-field-job'}" StyleClasses="AshfallDossierLabel" VAlign="Center" MinWidth="110" />
                                    <OptionButton Name="JobOption" HorizontalExpand="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <Button Name="ConfirmCandidateButton" StyleClasses="AshfallPrimaryAction" MinHeight="44" HorizontalExpand="True" Margin="0 4 0 0" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <Control VerticalExpand="True" />
    </BoxContainer>
</PanelContainer>
