<PanelContainer xmlns="https://spacestation14.io"
                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:ashfall="clr-namespace:Content.Client.Ashfall.CharacterGen.UI"
                HorizontalExpand="True" VerticalExpand="True">
    <PanelContainer.PanelOverride>
        <graphics:StyleBoxFlat BackgroundColor="#0A0B0D" />
    </PanelContainer.PanelOverride>

    <ashfall:AshfallDossierBackground />

    <BoxContainer Orientation="Vertical" Margin="32 24" SeparationOverride="12" HorizontalExpand="True" VerticalExpand="True">
        <!-- Top Strip: centered back link, progress rail at the right edge -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="30">
            <Control HorizontalExpand="True" />
            <Button Name="BackButton" Text="{Loc 'ashfall-lifepath-back-button'}" StyleClasses="AshfallInlineAction" />
            <Control HorizontalExpand="True" />
            <BoxContainer Name="ProgressRail" Orientation="Horizontal" SeparationOverride="6" VerticalAlignment="Center" />
            <Control MinWidth="12" />
            <Label Name="StepCounterLabel" StyleClasses="AshfallDossierLabel" VAlign="Center" />
        </BoxContainer>

        <!-- Body: Left Column has Character Identity + Portrait + Chronicle; Right Column has Narrative Options -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="40" HorizontalExpand="True" VerticalExpand="True">
            <!-- Left Column: Character Card & Chronicle -->
            <BoxContainer Orientation="Vertical" MinWidth="340" MaxWidth="380" SeparationOverride="12" VerticalExpand="True">
                <PanelContainer Name="CharacterCard" HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#111316E6" BorderColor="#24282E" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="12" HorizontalExpand="True">
                        <!-- Portrait Area -->
                        <PanelContainer Name="SpriteFrame" MinHeight="260" HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#0A0B0D" BorderColor="#1A1C20" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True">
                                <ashfall:ProfileFullBodySpriteView Name="PreviewSprite" HorizontalExpand="True" MinHeight="244" />
                            </BoxContainer>
                        </PanelContainer>

                        <!-- Identity Plate (Name, Culture, Reroll) -->
                        <BoxContainer Name="IdentityBlock" Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
                                <Label Name="CharacterNameLabel" StyleClasses="AshfallCandidateName" HorizontalExpand="True" VAlign="Center" ClipText="True" />
                                <Button Name="RerollNameButton" Text="{Loc 'ashfall-lifepath-reroll-name'}" StyleClasses="AshfallUtilityAction" MinHeight="26" Visible="False" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
                                <Label Name="CharacterBioLabel" StyleClasses="AshfallDossierLabel" VAlign="Center" HorizontalExpand="True" />
                                <Label Name="CharacterJobTag" StyleClasses="AshfallDossierLabel" VAlign="Center" />
                            </BoxContainer>
                        </BoxContainer>

                        <!-- Divider -->
                        <PanelContainer SetSize="0 1" HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#22252A" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>

                        <!-- Chronicle / Ledger (Records chosen steps dynamically) -->
                        <BoxContainer Name="ChronicleContainer" Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- Right Column: Narrative dialogue choices / Final dossier -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <Control Name="TopSpacer" VerticalExpand="True" />
                <BoxContainer Name="ContentColumn" Orientation="Vertical" SeparationOverride="20" HorizontalExpand="True" MaxWidth="720">
                    <Label Name="PromptQuestionLabel" StyleClasses="AshfallDossierDisplay" />

                    <!-- Steps 1-4: Narrative Choices -->
                    <BoxContainer Name="OptionsContainer" Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True" Margin="0 4 0 0" />

                    <!-- Step 5: Final Dossier Decisions -->
                    <BoxContainer Name="DossierContainer" Orientation="Vertical" SeparationOverride="14" HorizontalExpand="True" Visible="False">
                        <BoxContainer Name="DossierSections" Orientation="Vertical" SeparationOverride="12" HorizontalExpand="True" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True" Margin="0 6 0 0">
                            <Label Text="{Loc 'ashfall-lifepath-field-experience'}" StyleClasses="AshfallDossierLabel" VAlign="Center" MinWidth="100" />
                            <OptionButton Name="ExperienceOption" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                            <Label Text="{Loc 'ashfall-lifepath-field-job'}" StyleClasses="AshfallDossierLabel" VAlign="Center" MinWidth="100" />
                            <OptionButton Name="JobOption" HorizontalExpand="True" />
                        </BoxContainer>
                        <Button Name="ConfirmCandidateButton" StyleClasses="AshfallPrimaryAction" MinHeight="44" HorizontalExpand="True" Margin="0 10 0 0" />
                    </BoxContainer>
                </BoxContainer>
                <Control Name="BottomSpacer" VerticalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
