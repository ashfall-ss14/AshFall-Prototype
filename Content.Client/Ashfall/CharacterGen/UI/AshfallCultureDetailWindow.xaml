<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               MinSize="580 620"
               SetSize="580 680">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <PanelContainer StyleClasses="AshfallPanelDeep" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="4">
                <Label Name="CandidateNameLabel" StyleClasses="FancyWindowTitle" FontColorOverride="#D48944" />
                <Label Name="CandidateBioLabel" FontColorOverride="#878C87" />
                <RichTextLabel Name="CandidateCultureLabel" />
            </BoxContainer>
        </PanelContainer>

        <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ContentContainer" Orientation="Vertical" HorizontalExpand="True" Margin="4 0" SeparationOverride="12" />
        </ScrollContainer>

        <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

        <Button Name="DetailsCloseButton" Text="{Loc 'ashfall-culture-window-close'}" StyleClasses="AshfallSecondaryAction" HorizontalAlignment="Right" MinWidth="120" MinHeight="32" />
    </BoxContainer>
</DefaultWindow>
