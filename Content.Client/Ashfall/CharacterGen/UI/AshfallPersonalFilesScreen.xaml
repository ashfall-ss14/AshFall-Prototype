<PanelContainer xmlns="https://spacestation14.io"
                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:layout="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:preview="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
                xmlns:ashfall="clr-namespace:Content.Client.Ashfall.CharacterGen.UI"
                HorizontalExpand="True" VerticalExpand="True">
    <PanelContainer Name="BackgroundPanel" StyleClasses="AshfallPanelDeep" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="16 10" SeparationOverride="8">
            <PanelContainer StyleClasses="AshfallHeaderPanel" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="12 8" SeparationOverride="3">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Text="{Loc 'ashfall-personal-files-title'}" StyleClasses="FancyWindowTitle" FontColorOverride="#A3A8A3" HorizontalExpand="True" />
                        <Label Name="HeaderStatusLabel" StyleClasses="Status" VAlign="Center" />
                    </BoxContainer>
                    <Label Text="{Loc 'ashfall-personal-files-subtitle'}" FontColorOverride="#878C87" />
                </BoxContainer>
            </PanelContainer>

            <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">
                <!-- LEFT: candidates (upper) + assignment selection + priority slots (lower) -->
                <PanelContainer StyleClasses="AshfallPanel" HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer Name="LeftColumnScroll" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6" SeparationOverride="6">
                            <PanelContainer Name="CandidatesPanel" StyleClasses="AshfallPanelDeep" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6">
                                    <GridContainer Name="CandidatesGrid" Columns="2" HorizontalExpand="True"
                                                   HSeparationOverride="6" VSeparationOverride="6" />
                                </BoxContainer>
                            </PanelContainer>

                            <layout:LayoutContainer Name="AssignmentSlotContainer" HorizontalExpand="True" RectClipContent="True" Visible="False">
                                <PanelContainer Name="AssignmentPanel" StyleClasses="AshfallPanelDeep">
                                    <BoxContainer Orientation="Vertical" Margin="10 7" SeparationOverride="5" HorizontalExpand="True">
                                        <Label Name="AssignmentHeading" Text="{Loc 'ashfall-personal-files-assignment-heading'}" StyleClasses="FancyWindowTitle" FontColorOverride="#D48944" ToolTip="{Loc 'ashfall-personal-files-assignment-help'}" HorizontalExpand="True" ClipText="True" />
                                        <GridContainer Name="JobsGrid" Columns="2" HorizontalExpand="True" HSeparationOverride="6" VSeparationOverride="4" />
                                    </BoxContainer>
                                </PanelContainer>
                            </layout:LayoutContainer>

                            <Control Name="LeftFlowSpacer" VerticalExpand="True" Visible="False" />

                            <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4 2" SeparationOverride="6">
                                <Label Name="PriorityHeading" Text="{Loc 'ashfall-personal-files-priority-heading'}" StyleClasses="FancyWindowTitle" FontColorOverride="#D48944" ToolTip="{Loc 'ashfall-personal-files-priority-help'}" />
                                <GridContainer Name="PrioritySlotsGrid" Columns="5" HorizontalExpand="True" HSeparationOverride="6" VSeparationOverride="6" />
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="20" SetHeight="20">
                                    <Label Name="PriorityHintLabel" FontColorOverride="#B0574C" VerticalAlignment="Center" HorizontalExpand="True" ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>

                <!-- RIGHT: dossier only (clipped for smooth slide-in from right) -->
                <layout:LayoutContainer Name="DossierSlotContainer" HorizontalExpand="True" VerticalExpand="True" RectClipContent="True">
                    <!-- Faint ambient sketch, drawn behind the dossier panel and covered by it. -->
                    <TextureRect Name="AmbientAnim" Stretch="KeepAspectCentered"
                                 ModulateSelfOverride="#FFFFFF08" MouseFilter="Ignore" />
                    <PanelContainer Name="DossierPanel" StyleClasses="AshfallPanel">
                        <ScrollContainer Name="DossierScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="18 14" SeparationOverride="6">
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                    <Label Name="DossierNameLabel" StyleClasses="FancyWindowTitle" FontColorOverride="#D48944" HorizontalExpand="True" ClipText="True" />
                                    <Label Name="DossierNumberLabel" StyleClasses="Status" FontColorOverride="#878C87" Align="Right" VAlign="Center" Margin="10 0 0 0" />
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="16">
                                    <PanelContainer MinSize="150 180" SetSize="150 180">
                                        <PanelContainer.PanelOverride>
                                            <graphics:StyleBoxFlat BackgroundColor="#151617" BorderColor="#26282A" BorderThickness="1" />
                                        </PanelContainer.PanelOverride>
                                        <layout:LayoutContainer RectClipContent="True">
                                            <ashfall:ProfilePortraitSpriteView Name="DossierPreview" MinSize="150 180" SetSize="150 180" PortraitFraction="0.52" VerticalOffset="14" HorizontalOffset="5" />
                                            <!-- Retro CRT static over the restored photo. -->
                                            <TextureRect Name="PortraitNoise" Stretch="Tile" MouseFilter="Ignore" MinSize="150 180" SetSize="150 180" />
                                        </layout:LayoutContainer>
                                    </PanelContainer>
                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
                                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                            <BoxContainer Name="DossierIdentityFacts" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" />
                                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                                <BoxContainer Name="DossierSpeciesFacts" Orientation="Horizontal" />
                                                <Label Text="|" FontColorOverride="#43464B" VAlign="Top" />
                                                <Button Name="CultureWikiButton" Text="{Loc 'ashfall-dossier-culture-wiki'}" StyleClasses="AshfallInlineAction" VerticalAlignment="Top" />
                                            </BoxContainer>
                                        </BoxContainer>
                                        <BoxContainer Name="DossierCultureFacts" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" />
                                        <BoxContainer Name="DossierBirthplaceFacts" Orientation="Horizontal" HorizontalExpand="True" />
                                    </BoxContainer>
                                </BoxContainer>

                                <PanelContainer HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BackgroundColor="#202123" BorderColor="#383A3D" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="10 5" SeparationOverride="1">
                                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                            <Label Text="{Loc 'ashfall-dossier-skills-summary-heading'}" StyleClasses="AshfallTerminalHeader" FontColorOverride="#878C87" VAlign="Center" />
                                            <Label Text="|" FontColorOverride="#43464B" VAlign="Center" Margin="6 0" />
                                            <Button Name="SkillsDetailsButton" Text="{Loc 'ashfall-dossier-skills-details-button'}" StyleClasses="AshfallInlineAction" />
                                            <Control HorizontalExpand="True" />
                                        </BoxContainer>
                                        <RichTextLabel Name="DossierSkillsSummary" HorizontalExpand="True" />
                                    </BoxContainer>
                                </PanelContainer>

                                <!-- Confirmed-assignment status line: own full-width row so it can
                                     never be covered by the section plates below. -->
                                <Label Name="DossierSelectionLabel" FontColorOverride="#D48944" Margin="0 2 0 0" />

                                <!-- Passport block separator: dim cool rule, quieter than the amber HLines. -->
                                <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" ModulateSelfOverride="#2E3033" />

                                <BoxContainer Name="DossierSections" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                            </BoxContainer>
                        </ScrollContainer>
                    </PanelContainer>
                </layout:LayoutContainer>
            </BoxContainer>

            <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10" MinHeight="40">
                <Button Name="RefreshButton" Text="{Loc 'ashfall-personal-files-refresh'}" StyleClasses="AshfallSecondaryAction" MinHeight="36" MinWidth="220" />
                <Label Name="CooldownLabel" VAlign="Center" StyleClasses="Status" ClipText="True" />
                <Control HorizontalExpand="True" />
                <Button Name="BackButton" Text="{Loc 'ashfall-personal-files-back'}" StyleClasses="AshfallUtilityAction" MinHeight="36" MinWidth="140" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</PanelContainer>
