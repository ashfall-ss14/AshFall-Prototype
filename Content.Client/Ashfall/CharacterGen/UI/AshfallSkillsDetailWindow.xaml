<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               MinSize="540 600"
               SetSize="540 650">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <PanelContainer StyleClasses="AshfallPanelDeep" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="4">
                <Label Name="CandidateNameLabel" StyleClasses="FancyWindowTitle" FontColorOverride="#D48944" />
                <Label Name="CandidateBioLabel" FontColorOverride="#878C87" />
                <Label Name="CandidateJobLabel" FontColorOverride="#A3A8A3" />
            </BoxContainer>
        </PanelContainer>

        <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="CategoriesContainer" Orientation="Vertical" HorizontalExpand="True" Margin="4 0" SeparationOverride="12" />
        </ScrollContainer>

        <controls:Separator Orientation="Horizontal" StyleClasses="highlight" Thickness="1" />

        <Button Name="DetailsCloseButton" Text="{Loc ashfall-skills-window-close}" StyleClasses="AshfallSecondaryAction" HorizontalAlignment="Right" MinWidth="120" MinHeight="32" />
    </BoxContainer>
</DefaultWindow>
