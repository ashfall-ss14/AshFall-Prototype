<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         MinHeight="40">
    <controls:StripeBack HasBottomEdge="False">
        <BoxContainer Orientation="Horizontal" Align="End" Margin="4 6 8 6" SeparationOverride="6">
            <Button Name="DefaultButton"
                    Text="{Loc 'ui-options-default'}"
                    TextAlign="Center"
                    Margin="0 0 12 0" />

            <Button Name="ResetButton"
                    Text="{Loc 'ui-options-reset-all'}"
                    StyleClasses="negative" />
            <Button Name="ApplyButton"
                    Text="{Loc 'ui-options-apply'}" />
        </BoxContainer>
    </controls:StripeBack>
</Control>
